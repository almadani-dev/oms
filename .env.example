APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Used only by DatabaseSeeder to bootstrap the very first Super Admin user
# when none exists yet — required only in that case, never committed with a
# real value. See config/oms.php.
OMS_BOOTSTRAP_ADMIN_EMAIL=
OMS_BOOTSTRAP_ADMIN_NAME=
OMS_BOOTSTRAP_ADMIN_PASSWORD=

# OMS Backup & Restore (Task 7) — never commit real values. No default
# encryption key exists anywhere in code; a missing/invalid key here makes
# backup creation fail closed rather than produce an unencrypted archive.
# OMS_MYSQLDUMP_PATH: absolute path to mysqldump (e.g. on Windows/Laragon,
# "C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe"). Leave empty
# on Linux hosts where mysqldump is already on PATH.
OMS_MYSQLDUMP_PATH=
# OMS_MYSQL_CLIENT_PATH: reserved for the future independent Restore CLI.
OMS_MYSQL_CLIENT_PATH=
# OMS_BACKUP_ENCRYPTION_KEY_ID: a short label for the active key (e.g. "2026-07").
OMS_BACKUP_ENCRYPTION_KEY_ID=
# OMS_BACKUP_ENCRYPTION_KEY: base64-encoded 32-byte libsodium Secretstream
# key. Generate with: php -r "echo base64_encode(sodium_crypto_secretstream_xchacha20poly1305_keygen());"
OMS_BACKUP_ENCRYPTION_KEY=
# OMS_BACKUP_PREVIOUS_KEYS: "key_id:base64key,key_id2:base64key2" — only
# used to decrypt/verify older backups after a key rotation.
OMS_BACKUP_PREVIOUS_KEYS=
OMS_BACKUP_DUMP_TIMEOUT=1800
OMS_BACKUP_JOB_TIMEOUT=3600

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

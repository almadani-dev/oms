# OMS STRESS PROFILE — LOCAL DEVELOPMENT ONLY. Never deploy, never commit .env.stress.
#
# Create your private .env.stress by COPYING your own local .env, then change
# ONLY the keys below. Keep your local DB username/password as they are in .env
# (this example deliberately contains no credentials or keys).
#
# Used with:  php artisan --env=stress <command>
# See docs/STRESS_ENVIRONMENT.md.

APP_ENV=stress

# The dedicated stress database on the local MySQL server. Never `oms`.
DB_DATABASE=oms_stress

# Every disk (attachments, report snapshots, exports, logs, framework cache)
# lives under this directory instead of storage/. Use the ABSOLUTE path of
# <project root>\storage\stress on your machine, e.g.:
LARAVEL_STORAGE_PATH=C:\laragon\www\oms\storage\stress
